---
import ProfilePlaceholder from "../../../../assets/images/placeholder/profile.jpg";
import CoverPlaceholder from "../../../../assets/images/placeholder/cover.avif"
import { Icon } from "astro-icon/components";

// Reactions
import Reactions from "../Reactions.svelte"


const formatter = new Intl.NumberFormat("en-US", {
  notation:"compact",
  maximumFractionDigits: 2
})

const views = formatter.format(1300000)
---

<div class="flex flex-col gap-2 bg-black/40 rounded-xl p-2 md:p-5">
    <div class="flex">
        <!-- MANGA COVER -->
        <div class="shrink-0 grow-0 aspect-[0.707] w-30 rounded-xl md:w-70 bg-black overflow-hidden">
            <img class="object-fill" src={CoverPlaceholder.src} />
        </div>
        
        <!-- Review -->
        <div class="md:p-10 p-2 flex flex-col gap-5 my-auto">
            
            <!-- PROFILE DETAILS -->
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2">
                    <!-- PROFILE IMAGE -->
                    <img
                        class="w-7 rounded-full border border-white/7"
                        src={ProfilePlaceholder.src}
                        alt="profilePic"
                    />
                    <h1>barden</h1>
                </div>

            </div>
            
            <h1 class="md:text-3xl">"This Changed my Life"</h1>
            
            <p class="text-[10px] md:text-xl italic min-w-0">
                Nisio Isin's Monogatari series stands apart in light novels. Its
                razor-sharp dialogue and playful wordplay turn Araragi's encounters
            </p>
    
            <!-- Extra -->
            <div class="flex items-center">
                <Icon class="text-2xl mx-2" name="material-symbols-light:star" />
                <h1 class="text-2xl md:text-4xl font-bold font-review">9.3 <span class="text-xl">/ 10</span></h1>
            </div>        

            <div class="hidden md:flex gap-1">
                <button class="flex-1 rounded-xl hover:bg-black/20 cursor-pointer opacity-50 hover:opacity-100 border border-white/10 p-2 flex items-center gap-2"> <Icon class="text-2xl" name="material-symbols-light:bookmark-add-outline" /> Add to Bookmarks</button>
                <button class="flex-1 rounded-xl hover:bg-black/20 cursor-pointer opacity-50 hover:opacity-100 border border-white/10 p-2 flex items-center gap-2"> <Icon class="text-2xl" name="material-symbols-light:map-pin-review" /> Read Review</button>
            </div>
        </div>
    </div>

    <!-- MOBILE VIEW BUTTONS -->
    <div class="md:hidden flex">
        <button class="flex-1 p-2 text-[14px] rounded-xl border material-glass">Add to Bookmarks</button>
        <button class="flex-1 p-2 text-[14px] rounded-xl border material-glass">Read this Review</button>
    </div>
    
</div>
