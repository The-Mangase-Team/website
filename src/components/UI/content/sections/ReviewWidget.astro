---
import ProfilePlaceholder from "../../../../assets/images/placeholder/profile.jpg";
---

<div class="flex cursor-pointer">
    <!-- MANGA COVER -->
    <div class="shrink-0 aspect-[0.707] w-70 bg-black"></div>
    <!-- Review -->
    <div class="p-10 flex flex-col gap-5 my-auto">
        <!-- PROFILE DETAILS -->
        <div class="flex items-center gap-2">
            <!-- PROFILE IMAGE -->
            <img
                class="w-7 rounded-full"
                src={ProfilePlaceholder.src}
                alt="profilePic"
            />

            <h1>barden</h1>
        </div>

        <p class="text-xl italic min-w-0">
            Nisio Isin's Monogatari series stands apart in light novels. Its
            razor-sharp dialogue and playful wordplay turn Araragi's encounters
            with supernatural oddities into surprisingly profound explorations
            of loneliness, guilt, and growth.
        </p>

        <!-- Extra -->
        <div>
            <h1 class="text-4xl font-bold font-review">9.3/10</h1>
        </div>
    </div>
</div>
