---
import ReviewWidget from "./ReviewWidget.astro";
import { Icon } from "astro-icon/components";
---

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);
    let ctx: gsap.Context;

    function initAnimation() {
        ctx?.revert();

        ctx = gsap.context(() => {
            gsap.utils.toArray<HTMLElement>(".reviewWidget").forEach((el) => {
                gsap.fromTo(
                    el,
                    { autoAlpha: 0, y: 30 },
                    {
                        y: 0,
                        autoAlpha: 1,
                        duration: 0.9,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: el,
                            start: "top 100%",
                            once: false,
                        },
                    },
                );
            });
        });
    }

    initAnimation();
    document.addEventListener("astro:page-load", initAnimation);
</script>

<h1 class="reviewWidget hidden md:flex mb-5 text-4xl font-ui">Reviews</h1>

<main class="reviewWidget mb-2 md:max-w-250 w-full flex md:flex-row flex-col items-center gap-10">
    <button class="hidden group text-5xl md:flex">
        <Icon
            class="group-hover:hidden block cursor-pointer"
            name="material-symbols-light:arrow-circle-left-outline"
        />
        <Icon
            class="group-hover:block hidden cursor-pointer"
            name="material-symbols-light:arrow-circle-left"
        />
    </button>

    <ReviewWidget />
    
    <button class="hidden group text-5xl md:flex">
        <Icon
            class="group-hover:hidden block cursor-pointer"
            name="material-symbols-light:arrow-circle-right-outline"
        />
        <Icon
            class="group-hover:block hidden cursor-pointer"
            name="material-symbols-light:arrow-circle-right"
        />
    </button>
</main>
