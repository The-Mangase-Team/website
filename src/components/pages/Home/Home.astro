---
import Search from "../../UI/Search.svelte"
import Spotlight from "./Components/Spotlight.svelte";
import MangaWidget from "../../UI/content/Manga/Widget.svelte"
import Discover from "../../UI/content/sections/Discover.svelte";
---


<!-- Comics Billboard -->
<main class="z-0 font-ui m-auto max-w-900 flex flex-col gap-1 px-2 md:px-33">
    
    <!-- SEARCH BAR -->
    <div class="w-full flex flex-row mb-2.5 md:mb-15 mt-3">
        <div class="flex-1"></div>
        <div class="flex-1 items-center">
            <div class="w-50 md:w-75">
                <Search />
            </div>
        </div>
        <div class="flex-1"></div>
    </div>

    <!-- RECENTLY UPDATED -->
    <div class="flex flex-col flex-1">

        <div class="w-90 md:w-259 mx-auto box-border h-auto flex snap-x snap-mandatory overflow-x-auto overflow-y-hidden gap-1">    
            <MangaWidget />
            <MangaWidget />
            <MangaWidget />
            <MangaWidget />
            <MangaWidget />
        </div>
    </div>

    <!-- Newly Added / Most Popular (toggle) -->
    <div class="min-h-screen">
        <Discover />
    </div>
</main>
