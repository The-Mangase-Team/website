---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components'

// COMPONENTS
import Search from '../components/UI/Search.svelte';

const tagLine = "Read Webcomics, or Publish Them."

const faqQuestions = [
    {
        question: "Q: How do I publish a webcomic?",
        answer: "A: To publish a webcomic, create a publisher/author profile and click the plus icon.",
    },
    {
        question: "Q: How much do I earn for publishing?",
        answer: "A: You get 75% of the ads displayed on the chapters of your comic.",
    },
];

---

<Layout title="mangase">
    <div class="h-full justify-self-center p-ui gap-ui m-auto flex flex-col">
        <!-- TITLE -->
        <div class="md:my-10 select-none">
            <h1 class="text-mobile-title font-black md:text-9xl">mangase</h1>
            <p class="italic -translate-y-24 md:translate-y-0">{tagLine}</p>
        </div>
        
        <!-- SEARCH BAR + [BROWSE LIBRARY] -->
        <Search client:load />
        <div class="flex gap-1 justify-center z-1">
            <a href="/home" class="material-glass text-center shrink-0 flex p-2 select-none">browse library</a>
            <a href="/create" class="material-glass text-center shrink-0 flex p-2 select-none">publish comics</a>
        </div>
    
        <!-- How'd you find out about us? -->
        <div class="group select-none flex gap-1 text-center w-fit mx-auto px-2 items-center mt-5">
            <a class="group-hover:underline group-hover:cursor-pointer underline-offset-4 uppercase font-ui font-extralight">How'd you find out about us?</a>
            <span class="group-hover:opacity-100 opacity-100 md:opacity-0">
                <Icon name="link"/>
            </span>
        </div>

        <!-- FAQ -->
        <h2 class="mx-auto font-mono font-extralight bg-main text-center w-15 md:w-[10%] translate-y-5.5 md:translate-y-5">FAQ</h2>
        <div class="mx-auto py-ui border-t border-b border-white/10 select-none md:max-w-100 max-w-[95%] w-full">
            <!-- FAQ Questions -->
            <div class="flex flex-col gap-1 my-3 ">
                {faqQuestions.map((question) => (
                    <details class="material-glass font-ui hover:bg-primary/50 hover:cursor-pointer duration-ui bg-primary/10 open:bg-primary/50">
                        <summary class="list-none font-bold p-ui ">{question.question}</summary>
                        <p class="text-wrap p-ui ">{question.answer}</p>
                    </details>
                ))}
            </div>
        </div>
    </div>
</Layout>
